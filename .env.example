# Crie uma chave no Google Cloud, restrita à Places API (New), e coloque-a no .env local.
GOOGLE_MAPS_API_KEY=

# Chave da API do Gemini, usada pelo chat inteligente (Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Opcional: endereço do proxy Places usado pelo servidor MCP.
PLACES_PROXY_URL=http://127.0.0.1:8000/api/places/search
